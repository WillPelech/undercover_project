# --- Database (required) ---
# Local dev uses SQLite by default — no setup needed, just run `npm run db:migrate`.
DATABASE_URL="file:./dev.db"

# --- Auth (optional — app runs in an open "dev mode" without these) ---
# Create a project at https://dashboard.clerk.com to get these.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# --- AI email drafting (optional — falls back to a static template without this) ---
# ANTHROPIC_API_KEY=

# --- Google Drive export (optional — export button reports "not configured" without these) ---
# Create a service account in Google Cloud Console, enable the Drive API,
# and share the target parent folder with the service account's email.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- Cron auth (optional — required once deployed so /api/cron/nudges can't be hit by anyone) ---
# Vercel sets this automatically as `Authorization: Bearer $CRON_SECRET` when
# calling scheduled functions defined in vercel.json.
# CRON_SECRET=
